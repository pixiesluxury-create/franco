{%- comment -%}
  Oferta de un producto: busca el pack con más ahorro frente a comprar las mismas unidades sueltas
  (solo precios de las variantes). mode 'saving' -> imprime el ahorro en centavos (0 si no hay). mode 'row' -> la tarjeta.
{%- endcomment -%}
{%- capture nd_vlist -%}{%- render 'nd-variants', product: product, key: key, preview_ok: preview_ok -%}{%- endcapture -%}
{%- assign nd_vl = nd_vlist | split: ';;' -%}
{%- assign nd_single = 0 -%}{%- assign nd_have = false -%}{%- assign nd_best = 0 -%}{%- assign nd_best_price = 0 -%}{%- assign nd_best_u = 1 -%}
{%- for row in nd_vl -%}
  {%- assign f = row | split: '|' -%}
  {%- if f[1] == '1' and nd_have == false -%}{%- assign nd_single = f[2] | plus: 0 -%}{%- assign nd_have = true -%}{%- endif -%}
{%- endfor -%}
{%- if nd_have -%}
  {%- for row in nd_vl -%}
    {%- assign f = row | split: '|' -%}
    {%- assign un = f[1] | plus: 0 -%}
    {%- if un > 1 and f[4] == '1' -%}
      {%- assign pr = f[2] | plus: 0 -%}
      {%- assign sep = nd_single | times: un | minus: pr -%}
      {%- if sep > nd_best -%}{%- assign nd_best = sep -%}{%- assign nd_best_price = pr -%}{%- assign nd_best_u = un -%}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- if mode == 'saving' -%}{{ nd_best }}{%- else -%}
  {%- if nd_best > 0 -%}
    {%- capture nd_url -%}{%- render 'nd-url', product: product, key: key -%}{%- endcapture -%}
    {%- assign nd_ref = nd_single | times: nd_best_u -%}
    {%- assign nd_pct = nd_best | times: 100.0 | divided_by: nd_ref | round -%}
    {%- assign nd_each = nd_best_price | times: 1.0 | divided_by: nd_best_u | round -%}
    {%- capture nd_pn -%}{%- render 'nd-packnames', key: key, size: nd_best_u, field: 'n' -%}{%- endcapture -%}
    {%- capture nd_ps -%}{%- render 'nd-packnames', key: key, size: nd_best_u, field: 's' -%}{%- endcapture -%}
    <article class="nd-offer{% if is_best %} is-best{% endif %}" data-reveal style="--tint: {{ tint | default: '#eaf4fd' }}">
      <a class="nd-offer-media" href="{{ nd_url }}?pack={{ nd_best_u }}#elegir-pack" tabindex="-1" aria-hidden="true"><img src="{{ img | asset_url }}" alt="" width="240" height="240" loading="lazy" decoding="async" style="--pos: {{ pos }}"></a>
      <div class="nd-offer-body">
        {%- if is_best -%}<span class="nd-tag nd-tag-save nd-tag-shine">Mayor ahorro</span>{%- endif -%}
        <h3 class="nd-offer-title">{{ nd_pn }} <span>· {{ name }}</span></h3>
        <p class="nd-offer-sub">{{ nd_ps }}</p>
        <p class="nd-offer-price"><b>{{ nd_best_price | money_without_trailing_zeros }}</b><s><span class="nd-sr">Por separado </span>{{ nd_ref | money_without_trailing_zeros }}</s></p>
        <p class="nd-offer-save"><b>Ahorrás <span data-nd-count="{{ nd_best | divided_by: 100 }}" data-nd-money="{{ nd_best | money_without_trailing_zeros }}">{{ nd_best | money_without_trailing_zeros }}</span></b> <span>({{ nd_pct }}%) frente a comprar {{ nd_best_u }} por separado</span></p>
        <p class="nd-offer-each">Cada una te sale <b>{{ nd_each | money_without_trailing_zeros }}</b>{% if settings.nd_cuotas_on %} · {{ settings.nd_cuotas | default: 3 }} cuotas sin interés{% endif %}{% if settings.nd_envio_on %} · envío gratis{% endif %}</p>
        <a class="nd-link" href="{{ nd_url }}?pack={{ nd_best_u }}#elegir-pack">Ver este pack {% render 'nd-icon', name: 'arrow', size: 16 %}</a>
      </div>
    </article>
  {%- endif -%}
{%- endif -%}
