{%- assign h1 = settings.nd_mandolina | default: all_products['mandolina-supremecut'] -%}
{%- assign h2 = settings.nd_mopa | default: all_products['mopa-plana-con-escurridor'] -%}
{%- assign h3 = settings.nd_tender | default: all_products['tender-retractil-de-pared'] -%}
{%- assign h4 = settings.nd_lapiz | default: all_products['lapiz-3d-y-pizarra-led'] -%}
{%- assign h5 = settings.nd_arrancador | default: all_products['arrancador-e-inflador-oryx'] -%}
<header class="nd-header" data-nd-header>
  <div class="nd-header-inner">
    <a href="{{ routes.root_url }}" class="nd-brand" aria-label="Nidomía, ir al inicio"><img width="150" height="43" src="{{ 'nd-marca-nidomia.svg' | asset_url }}" alt="Nidomía"></a>
    <nav class="nd-nav" aria-label="Productos">
      <a href="{{ routes.root_url }}#soluciones">Productos</a>
      <a href="{{ h1.url | default: routes.root_url }}">Cocina</a>
      <a href="{{ h2.url | default: routes.root_url }}">Limpieza</a>
      <a href="{{ h3.url | default: routes.root_url }}">Lavadero</a>
      <a href="{{ h4.url | default: routes.root_url }}">Creatividad</a>
      <a href="{{ h5.url | default: routes.root_url }}">Auto</a>
    </nav>
    <div class="nd-header-actions">
      <button type="button" class="nd-icon-btn nd-menu-btn" data-nd-menu-open aria-label="Abrir menú de productos" aria-haspopup="dialog">{% render 'nd-icon', name: 'menu', size: 22 %}</button>
      <a href="{{ routes.cart_url }}" class="nd-icon-btn nd-cart-btn" data-nd-cart-open aria-label="Abrir carrito, {{ cart.item_count }} {% if cart.item_count == 1 %}unidad{% else %}unidades{% endif %}">
        {% render 'nd-icon', name: 'bag', size: 22 %}
        <span class="nd-cart-count" data-nd-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>
<dialog class="nd-sheet" id="nd-menu" aria-label="Productos de Nidomía" data-nd-dialog>
  <div class="nd-sheet-head"><b>Productos</b><button type="button" class="nd-icon-btn" data-nd-close aria-label="Cerrar menú">{% render 'nd-icon', name: 'x', size: 22 %}</button></div>
  <ul class="nd-sheet-list">
    <li><a href="{{ h1.url | default: routes.root_url }}"><span>Cocina</span><b>Mandolina SupremeCut</b></a></li>
    <li><a href="{{ h2.url | default: routes.root_url }}"><span>Limpieza</span><b>Mopa con escurridor</b></a></li>
    <li><a href="{{ h3.url | default: routes.root_url }}"><span>Lavadero</span><b>Tender retráctil</b></a></li>
    <li><a href="{{ h4.url | default: routes.root_url }}"><span>Creatividad</span><b>Lápiz 3D + pizarra LED</b></a></li>
    <li><a href="{{ h5.url | default: routes.root_url }}"><span>Auto</span><b>Arrancador e inflador Oryx</b></a></li>
  </ul>
</dialog>
