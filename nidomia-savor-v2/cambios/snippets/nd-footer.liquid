{%- assign f1 = settings.nd_mandolina | default: all_products['mandolina-supremecut'] -%}
{%- assign f2 = settings.nd_mopa | default: all_products['mopa-plana-con-escurridor'] -%}
{%- assign f3 = settings.nd_tender | default: all_products['tender-retractil-de-pared'] -%}
{%- assign f4 = settings.nd_lapiz | default: all_products['lapiz-3d-y-pizarra-led'] -%}
{%- assign f5 = settings.nd_arrancador | default: all_products['arrancador-e-inflador-oryx'] -%}
{%- capture fu1 -%}{%- render 'nd-url', product: f1, key: 'mandolina' -%}{%- endcapture -%}
{%- capture fu2 -%}{%- render 'nd-url', product: f2, key: 'mopa' -%}{%- endcapture -%}
{%- capture fu3 -%}{%- render 'nd-url', product: f3, key: 'tender' -%}{%- endcapture -%}
{%- capture fu4 -%}{%- render 'nd-url', product: f4, key: 'lapiz' -%}{%- endcapture -%}
{%- capture fu5 -%}{%- render 'nd-url', product: f5, key: 'arrancador' -%}{%- endcapture -%}
<footer class="nd-footer">
{%- assign fp_n = settings.nd_cuotas | default: 3 -%}
{%- if settings.nd_cuotas_on or settings.nd_envio_on -%}
<div class="nd-footer-promo" aria-label="Beneficios de comprar en Nidomía">
  <ul class="nd-wrap">
    {%- if settings.nd_cuotas_on -%}<li><i class="nd-bico">{% render 'nd-icon', name: 'card', size: 20 %}</i><span><b>{{ fp_n }} cuotas sin interés</b> con tarjeta de crédito</span></li>{%- endif -%}
    {%- if settings.nd_envio_on -%}<li><i class="nd-bico nd-truck">{% render 'nd-icon', name: 'truck', size: 20 %}</i><span><b>{{ settings.nd_envio_texto | default: 'Envío gratis a todo el país' }}</b></span></li>{%- endif -%}
    <li><i class="nd-bico">{% render 'nd-icon', name: 'shield', size: 20 %}</i><span><b>Pago seguro</b> con Shopify</span></li>
  </ul>
</div>
{%- endif -%}

  <div class="nd-wrap nd-footer-grid">
    <div class="nd-footer-brand">
      <img width="150" height="43" src="{{ 'nd-marca-nidomia.svg' | asset_url }}" alt="Nidomía" loading="lazy">
      <p>Soluciones para tu casa y lo que hacés todos los días.</p>
    </div>
    <nav aria-label="Productos">
      <h2>Productos</h2>
      <ul>
        <li><a href="{{ fu1 }}">Mandolina SupremeCut</a></li>
        <li><a href="{{ fu2 }}">Mopa con escurridor</a></li>
        <li><a href="{{ fu3 }}">Tender retráctil</a></li>
        <li><a href="{{ fu4 }}">Lápiz 3D + pizarra LED</a></li>
        <li><a href="{{ fu5 }}">Arrancador e inflador</a></li>
      </ul>
    </nav>
    <nav aria-label="Tu compra">
      <h2>Tu compra</h2>
      <ul>
        <li><a href="{{ routes.cart_url }}">Carrito</a></li>
        {%- if shop.shipping_policy != blank -%}<li><a href="{{ shop.shipping_policy.url }}">Envíos</a></li>{%- endif -%}
        {%- if shop.refund_policy != blank -%}<li><a href="{{ shop.refund_policy.url }}">Cambios y devoluciones</a></li>{%- endif -%}
        {%- if shop.privacy_policy != blank -%}<li><a href="{{ shop.privacy_policy.url }}">Privacidad</a></li>{%- endif -%}
      </ul>
    </nav>
  </div>
  <div class="nd-wrap nd-footer-base"><span>© {{ 'now' | date: '%Y' }} Nidomía</span><span>Soluciones para el hogar</span></div>
</footer>
